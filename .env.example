# Application Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/video_transcription_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=video_transcription_db
DB_USER=user
DB_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-4

# Whisper Configuration (for transcription)
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=en

# ElevenLabs API Configuration (for AI voice narration)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_monolingual_v1

# Azure TTS Configuration (alternative to ElevenLabs)
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus
AZURE_TTS_VOICE_NAME=en-US-JennyNeural

# Replicate API Configuration (for AI models)
REPLICATE_API_KEY=your-replicate-api-key-here

# AWS Configuration (for S3 storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=video-transcription-storage
AWS_CLOUDFRONT_DOMAIN=

# Google Cloud Configuration (alternative to AWS)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
SESSION_SECRET=your-session-secret-change-this
BCRYPT_ROUNDS=10

# OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourapp.com

# SendGrid (alternative to SMTP)
SENDGRID_API_KEY=

# Stripe Configuration (for payments)
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Analytics & Monitoring
DATADOG_API_KEY=
DATADOG_APP_KEY=
SENTRY_DSN=
GOOGLE_ANALYTICS_ID=

# Feature Flags
ENABLE_VOICE_CLONING=false
ENABLE_MULTIPLAYER_EDITING=false
ENABLE_ADVANCED_ANALYTICS=false
ENABLE_PII_DETECTION=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_MINUTES=60
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,webm

# Worker Configuration
WORKER_CONCURRENCY=5
WORKER_MAX_RETRIES=3

# Chrome Extension
EXTENSION_ID=your-chrome-extension-id
EXTENSION_KEY=

# Webhook URLs
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Third-party Integrations
NOTION_API_KEY=
CONFLUENCE_API_KEY=
JIRA_API_KEY=
ZENDESK_API_KEY=

# Development & Testing
DEBUG=false
LOG_LEVEL=info
MOCK_AI_SERVICES=false
