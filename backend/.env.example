# Server Configuration
PORT=3000
NODE_ENV=development

# ============================================
# AI API KEYS (Required for full functionality)
# ============================================

# OpenAI API Key - Used for:
# - Whisper transcription
# - GPT-4 step detection
# Get your key at: https://platform.openai.com/api-keys
# NOTE: App works with MOCK DATA if this is not set (for demo)
OPENAI_API_KEY=

# ElevenLabs API Key - Used for:
# - AI voice narration
# Get your key at: https://elevenlabs.io/
# NOTE: App works with MOCK DATA if this is not set (for demo)
ELEVENLABS_API_KEY=

# ============================================
# Optional Configuration
# ============================================

# Database Configuration (optional for demo)
DATABASE_URL=postgresql://user:password@localhost:5432/screendocs_db

# Redis Configuration (optional for demo)
REDIS_URL=redis://localhost:6379

# AWS S3 Configuration (optional for demo)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=screendocs-videos

# Application URLs
FRONTEND_URL=http://localhost:3001

# File Upload Limits
MAX_FILE_SIZE_MB=500
